{
  "title": {
    "zh": "Cobuild OTX Lock 约束",
    "en": "Cobuild OTX Lock Constraints"
  },
  "subtitle": {
    "zh": "来源：xcshuan/cobuild-otx-contracts @f18eeaf contracts/cobuild-otx-lock/src、crates/cobuild-core/src、crates/cobuild-types/schemas　·　无官方部署（参考实现，测试夹具用 data2）",
    "en": "Source: xcshuan/cobuild-otx-contracts @f18eeaf contracts/cobuild-otx-lock/src, crates/cobuild-core/src, crates/cobuild-types/schemas　·　no official deployment (reference implementation; fixtures use data2)"
  },
  "transitions": [
    {
      "tag": "A",
      "title": {
        "zh": "交易级解锁：SighashAll / SighashAllOnly（无 OTX，或本 lock 有输入在 OTX 范围外）",
        "en": "Tx-level unlock: SighashAll / SighashAllOnly (no OTX, or this lock has inputs outside the OTX range)"
      },
      "inputs": [
        {
          "label": {
            "zh": "本 lock 的输入",
            "en": "inputs with this lock"
          },
          "body": "Cell{ lock: COBUILD_OTX_LOCK{ args: {{identity 20B}} } }"
        },
        {
          "label": {
            "zh": "witness[group 第一个输入]（carrier）",
            "en": "witness[group's first input] (carrier)"
          },
          "body": "{{SighashAll{ seal, message } | SighashAllOnly{ seal }}}"
        },
        {
          "label": {
            "zh": "witness[group 其他输入]",
            "en": "witness[other group inputs]"
          },
          "body": {
            "zh": "{{必须为空}}",
            "en": "{{must be empty}}"
          }
        }
      ],
      "outputs": [
        {
          "label": {
            "zh": "outputs：任意",
            "en": "outputs: any"
          },
          "body": {
            "zh": "由签名 hash 覆盖",
            "en": "covered by the signing hash"
          }
        }
      ],
      "layouts": [
        {
          "label": {
            "zh": "lock.args（20B）",
            "en": "lock.args (20B)"
          },
          "layout": [
            {
              "name": "identity",
              "size": "20B",
              "color": 0,
              "flex": 1,
              "role": {
                "zh": "blake2b-256(压缩 secp256k1 公钥)[0..20]（ckb-default-hash）",
                "en": "blake2b-256(compressed secp256k1 pubkey)[0..20] (ckb-default-hash)"
              },
              "cons": {
                "zh": "长度 = 20",
                "en": "length = 20"
              },
              "err": "20"
            }
          ]
        },
        {
          "label": {
            "zh": "witness = WitnessLayout（molecule union，item id）",
            "en": "witness = WitnessLayout (molecule union, item id)"
          },
          "layout": [
            {
              "name": "SighashAll",
              "size": "0xff000001",
              "color": 0,
              "flex": 1,
              "role": {
                "zh": "{ seal, message }：交易级签名 + Message",
                "en": "{ seal, message }: tx-level signature + Message"
              },
              "cons": {
                "zh": "全交易至多 1 个",
                "en": "at most one per tx"
              },
              "err": "33"
            },
            {
              "name": "SighashAllOnly",
              "size": "0xff000002",
              "color": 1,
              "flex": 1,
              "role": {
                "zh": "{ seal }：交易级签名",
                "en": "{ seal }: tx-level signature"
              },
              "err": ""
            },
            {
              "name": "Otx",
              "size": "0xff000003",
              "color": 2,
              "flex": 1,
              "role": {
                "zh": "一个 OTX：message、append_permissions、base_*、append_segments、base_seals",
                "en": "one OTX: message, append_permissions, base_*, append_segments, base_seals"
              },
              "cons": {
                "zh": "必须紧跟 OtxStart 或上一个 Otx",
                "en": "must directly follow OtxStart or the previous Otx"
              },
              "err": "31"
            },
            {
              "name": "OtxStart",
              "size": "0xff000004",
              "color": 3,
              "flex": 1,
              "role": {
                "zh": "{ start_input_cell, start_output_cell, start_cell_deps, start_header_deps }",
                "en": "{ start_input_cell, start_output_cell, start_cell_deps, start_header_deps }"
              },
              "cons": {
                "zh": "至多 1 个，后面至少 1 个 Otx",
                "en": "at most one, followed by ≥ 1 Otx"
              },
              "err": "31"
            }
          ],
          "note": {
            "zh": "不带 cobuild id 的 witness 视为 legacy；带保留 id 但 molecule 不合法 → 31 / 30",
            "en": "witnesses without a cobuild id are legacy; a reserved id with invalid molecule → 31 / 30"
          }
        },
        {
          "label": {
            "zh": "seal（65B，可恢复 secp256k1 签名）",
            "en": "seal (65B, recoverable secp256k1 signature)"
          },
          "layout": [
            {
              "name": "r ‖ s",
              "size": "64B",
              "color": 0,
              "flex": 4,
              "role": {
                "zh": "ECDSA 签名",
                "en": "ECDSA signature"
              },
              "cons": {
                "zh": "可解析",
                "en": "parses"
              },
              "err": "50"
            },
