              "name": "rec_id",
              "size": "1B",
              "color": 1,
              "flex": 1,
              "role": {
                "zh": "恢复 ID（k256 RecoveryId）",
                "en": "recovery id (k256 RecoveryId)"
              },
              "cons": {
                "zh": "0–3，恢复出的公钥 hash 前 20B = args",
                "en": "0–3; recovered pubkey hash[0..20] = args"
              },
              "err": "50"
            }
          ],
          "note": {
            "zh": "长度 ≠ 65 也返回 50（VerifyFailure）",
            "en": "length ≠ 65 also returns 50 (VerifyFailure)"
          }
        },
        {
          "label": {
            "zh": "签名 hash（blake2b-256，personal 16B）",
            "en": "signing hash (blake2b-256, 16B personal)"
