              "err": "30"
            },
            {
              "name": "tx_hash",
              "size": "32B",
              "color": 2,
              "flex": 1,
              "role": {
                "zh": "交易哈希",
                "en": "tx hash"
              },
              "err": "61"
            },
            {
              "name": "inputs",
              "size": "Σ",
              "color": 3,
              "flex": 2,
              "role": {
                "zh": "每个输入：CellOutput ‖ u32 len ‖ data",
                "en": "each input: CellOutput ‖ u32 len ‖ data"
              },
              "err": "62"
            },
            {
              "name": "extra witnesses",
              "size": "Σ",
              "color": 4,
              "flex": 2,
              "role": {
                "zh": "下标 ≥ 输入数的 witness：u32 len ‖ w",
                "en": "witnesses beyond input count: u32 len ‖ w"
              },
              "cons": {
                "zh": "长度 ≤ u32::MAX",
                "en": "length ≤ u32::MAX"
              },
              "err": "63"
            }
          ]
        },
        {
          "label": {
            "zh": "Action（Message.actions 的元素）",
            "en": "Action (element of Message.actions)"
          },
          "layout": [
            {
              "name": "script_info_hash",
              "size": "32B",
              "color": 0,
              "flex": 2,
              "role": {
                "zh": "脚本信息 hash",
                "en": "script info hash"
              },
              "err": ""
            },
            {
              "name": "script_role",
              "size": "1B",
              "color": 1,
              "flex": 1,
              "role": {
                "zh": "0 InputLock / 1 InputType / 2 OutputType",
                "en": "0 InputLock / 1 InputType / 2 OutputType"
              },
              "cons": {
                "zh": "∈ {0,1,2}",
                "en": "∈ {0,1,2}"
              },
              "err": "32"
            },
            {
              "name": "script_hash",
              "size": "32B",
              "color": 2,
              "flex": 2,
              "role": {
                "zh": "目标脚本 hash",
                "en": "target script hash"
              },
              "cons": {
                "zh": "交易中存在该角色的脚本",
                "en": "a script with that role exists in the tx"
              },
              "err": "32"
            },
            {
              "name": "data",
              "size": "Bytes",
              "color": 3,
              "flex": 2,
              "role": {
                "zh": "应用数据",
                "en": "application data"
              },
              "err": ""
            }
          ]
        }
      ],
      "limits": [
        {
          "field": "script.args",
          "cond": {
            "zh": "长度 = 20",
            "en": "length = 20"
          },
          "err": "20"
        },
        {
          "field": "witnesses",
          "cond": {
            "zh": "每个带 cobuild id 的 witness 都能按 WitnessLayout 解析",
            "en": "every witness carrying a cobuild id parses as WitnessLayout"
