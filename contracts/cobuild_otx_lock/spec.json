      "limits": [
        {
          "field": "script.args",
          "cond": {
            "zh": "长度 = 20",
            "en": "length = 20"
          },
          "err": "20"
        },
        {
          "field": "witnesses",
          "cond": {
            "zh": "每个带 cobuild id 的 witness 都能按 WitnessLayout 解析",
