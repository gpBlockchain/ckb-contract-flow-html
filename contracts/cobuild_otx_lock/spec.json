          "layout": [
            {
              "name": "personal",
              "size": "16B",
              "color": 0,
              "flex": 2,
              "role": {
                "zh": "有 Message：\"ckbcb_twm_core1\\0\"；无：\"ckbcb_tnm_core1\\0\"",
                "en": "with Message: \"ckbcb_twm_core1\\0\"; without: \"ckbcb_tnm_core1\\0\""
              },
              "err": ""
            },
            {
              "name": "message",
              "size": "var",
              "color": 1,
              "flex": 1,
              "role": {
                "zh": "唯一的 SighashAll.message（若有）",
                "en": "the unique SighashAll.message (if any)"
