          "err": "30 / 31"
        },
        {
          "field": "SighashAll",
          "cond": {
            "zh": "全交易至多 1 个 SighashAll（带 Message）",
            "en": "at most one SighashAll (with Message) in the tx"
          },
          "err": "33"
        },
        {
          "field": "carrier witness",
          "cond": {
            "zh": "group 第一个输入处的 witness 为 SighashAll 或 SighashAllOnly",
            "en": "witness at the group's first input is SighashAll or SighashAllOnly"
          },
          "err": "39"
        },
        {
          "field": {
            "zh": "group 其他 witness",
            "en": "other group witnesses"
          },
          "cond": {
            "zh": "必须为空",
            "en": "must be empty"
          },
          "err": "39"
        },
        {
          "field": "message.actions",
          "cond": {
            "zh": "每个 action 的 (script_role, script_hash) 指向交易中的脚本",
            "en": "each action's (script_role, script_hash) points to a script in the tx"
          },
          "err": "32"
        },
        {
          "field": "seal",
          "cond": {
            "zh": "65B，恢复出的公钥 blake160 = args",
            "en": "65B, recovered pubkey blake160 = args"
          },
          "err": "50"
        },
        {
          "field": {
            "zh": "签名要求",
            "en": "signature requirements"
          },
          "cond": {
            "zh": "至少 1 个（否则说明本 lock 无需签名）",
            "en": "at least one (otherwise nothing authorizes this lock)"
          },
          "err": "40"
        }
      ]
    },
    {
