{
  "title": {
    "zh": "standard-udt sUDT 元数据 Type Script 约束",
    "en": "standard-udt sUDT Metadata Type Script Constraints"
  },
  "subtitle": {
    "zh": "来源：xcshuan/ckb-standard-udt-contracts @d6e6da0 contracts/sudt-meta/src、lib/script-utils、lib/types　·　仓库未公布部署（SUDT_CODE_HASH 为构建期常量）",
    "en": "Source: xcshuan/ckb-standard-udt-contracts @d6e6da0 contracts/sudt-meta/src, lib/script-utils, lib/types　·　no deployment published (SUDT_CODE_HASH is a build-time constant)"
  },
  "transitions": [
    {
      "tag": "0 → Meta",
      "title": {
        "zh": "创建元数据（可同时首次铸造）",
        "en": "Create metadata (optionally with the initial mint)"
      },
      "inputs": [
        {
          "label": "inputs[0]",
          "body": {
            "zh": "任意 cell；决定 type id",
            "en": "any cell; determines the type id"
          }
        }
      ],
      "outputs": [
        {
          "label": {
            "zh": "元数据 cell",
            "en": "metadata cell"
          },
          "body": "Cell{\n  lock: ALWAYS_SUCCESS (data2),\n  type: SUDT_META{ args: {{type_id}} },\n  data: SudtMeta{ config_flags, {{current_supply}}, … }\n}"
        },
        {
          "label": {
            "zh": "sUDT（可选）",
            "en": "sUDT (optional)"
          },
          "body": "Cell{\n  type: SUDT{ args: meta_type_hash } (data2),\n  data: {{amount}}\n}"
        }
      ],
      "layouts": [
        {
          "label": {
            "zh": "元数据 cell data = SudtMeta（molecule table，9 字段）",
            "en": "Metadata cell data = SudtMeta (molecule table, 9 fields)"
          },
          "layout": [
            {
              "name": "header",
              "size": "4 + 9×4 B",
              "color": 0,
              "flex": 1,
              "role": {
                "zh": "molecule table 头",
                "en": "molecule table header"
              },
              "cons": {
                "zh": "结构合法",
                "en": "well-formed"
              },
              "err": "30 / 40"
            },
            {
              "name": "config_flags",
              "size": "1B",
              "color": 1,
              "flex": 1,
              "role": {
                "zh": "bit0 = SUPPLY_TRACKED；sUDT 只允许此位",
                "en": "bit0 = SUPPLY_TRACKED; sUDT allows only this bit"
              },
              "cons": {
                "zh": "⊆ 0x01",
                "en": "⊆ 0x01"
              },
              "err": "30 / 40"
            },
            {
              "name": "current_supply",
              "size": "16B u128 LE",
              "color": 2,
              "flex": 1,
              "role": {
                "zh": "跟踪的总供应",
                "en": "tracked total supply"
              },
              "cons": {
                "zh": "未跟踪时必须为 0",
                "en": "must be 0 when untracked"
              },
              "err": "31"
            },
            {
              "name": "decimals",
              "size": "1B",
              "color": 3,
              "flex": 1,
              "err": ""
            },
            {
              "name": "name / symbol / uri / extra_data",
              "size": "Bytes × 4",
              "color": 4,
              "flex": 3,
              "role": {
                "zh": "上限 1024 / 128 / 2048 / 16384 B",
                "en": "limits 1024 / 128 / 2048 / 16384 B"
              },
              "err": "30 / 40"
            },
            {
              "name": "mint_authority",
              "size": "AuthorityOpt",
              "color": 5,
              "flex": 2,
              "role": {
                "zh": "Authority{ type 0 InputLock | 1 InputType | 2 OutputType | 3 DynamicLinking | 4 Spawn, script_hash 32B, script: ScriptOpt }",
                "en": "Authority{ type 0 InputLock | 1 InputType | 2 OutputType | 3 DynamicLinking | 4 Spawn, script_hash 32B, script: ScriptOpt }"
              },
              "cons": {
                "zh": "0–2 时 script = None；3–4 时 script 的 hash = script_hash",
                "en": "script = None for 0–2; for 3–4 the script hashes to script_hash"
              },
              "err": "30 / 40"
            },
            {
              "name": "metadata_authority",
              "size": "AuthorityOpt",
              "color": 6,
              "flex": 2,
              "err": "30 / 40"
            }
          ],
          "hex": [
            [
              "header",
              "0x82000000 28000000 29000000 39000000 3a000000 42000000 49000000 4d000000 51000000 82000000"
            ],
            [
              "config_flags",
              "0x01"
            ],
            [
              "current_supply",
              "0x0010a5d4e8000000…00 (1 000 000 000 000)"
            ],
            [
              "decimals",
              "0x08"
            ],
            [
              "name / symbol",
              "0x0400000054657374 (\"Test\") ‖ 0x03000000545354 (\"TST\")"
            ],
            [
              "uri / extra_data",
              "0x00000000 ‖ 0x00000000"
            ],
            [
              "mint_authority",
              "0x31000000 10000000 11000000 31000000 00 ‖ abab…ab ‖ (None)"
            ],
            [
              "metadata_authority",
              "(None, 0 B)"
            ]
          ],
          "note": {
            "zh": "示例为按 metadata.mol 手工编码的 130B 值（tracked、InputLock 授权），非链上数据",
            "en": "Example is a hand-encoded 130B value following metadata.mol (tracked, InputLock authority), not on-chain data"
          }
        }
      ],
      "limits": [
        {
          "field": "args",
          "cond": {
            "zh": "= 32B",
            "en": "= 32B"
          },
          "err": "20"
        },
        {
          "field": {
            "zh": "组",
            "en": "group"
          },
          "cond": {
            "zh": "输入、输出各 ≤ 1 个；不能都为空",
            "en": "≤ 1 per side; not both empty"
          },
          "err": "21 / 20"
        },
        {
          "field": "output lock",
          "cond": {
            "zh": "hash_type = data2 且 code_hash = 0x3b521cc4…f7f1（always-success 白名单）",
            "en": "hash_type = data2 and code_hash = 0x3b521cc4…f7f1 (always-success whitelist)"
          },
          "err": "20"
        },
        {
          "field": "SudtMeta",
          "cond": {
            "zh": "Molecule、长度上限、config_flags ⊆ 0x01、Authority 形状",
            "en": "Molecule, size limits, config_flags ⊆ 0x01, Authority shape"
          },
          "err": "30"
        },
        {
          "field": "type id",
          "cond": {
            "zh": "args = blake2b(inputs[0] ‖ 输出序号 u64 LE)",
            "en": "args = blake2b(inputs[0] ‖ output index u64 LE)"
          },
          "err": "10"
        },
        {
          "field": "current_supply",
          "cond": {
            "zh": "tracked：= 输出中绑定 sUDT 总量；untracked：= 0",
            "en": "tracked: = total bound sUDT in outputs; untracked: = 0"
          },
          "err": "31"
        },
        {
          "field": {
            "zh": "授权",
            "en": "authority"
          },
          "cond": {
            "zh": "创建不检查任何 authority",
            "en": "creation checks no authority"
          },
          "err": "—"
        }
      ]
    },
