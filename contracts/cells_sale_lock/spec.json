        },
        {
          "label": "treasury",
          "body": {
            "zh": "纯输出 ≥ Σ fee（本交易所有卖家不在场的挂单）",
            "en": "pure outputs ≥ Σ fee (every offer in the tx whose seller is absent)"
          }
        }
      ],
      "layouts": [
        {
          "label": {
            "zh": "lock.args（40 字节）",
            "en": "lock.args (40 bytes)"
          },
          "layout": [
            {
              "name": "seller_lock_hash",
              "size": "32B",
              "role": {
                "zh": "卖家完整 lock hash，收款与撤单身份",
                "en": "seller full lock hash: payee and cancel identity"
              },
              "color": 1,
              "flex": 4
            },
            {
              "name": "price",
              "size": "8B LE",
              "role": {
                "zh": "要价（shannon），写在 args 里因此进入 lock hash，不可篡改",
