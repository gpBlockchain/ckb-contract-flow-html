      "inputs": [
        {
          "label": {
            "zh": "挂单 cell",
            "en": "offer cell"
          },
          "body": "Cell{ lock: SALE_LOCK(seller, price) }"
        },
        {
          "label": {
            "zh": "卖家输入",
            "en": "seller input"
          },
          "body": {
            "zh": "lock hash = {{seller_lock_hash}}，且不是 anyone-can-pay lock",
            "en": "lock hash = {{seller_lock_hash}}, not an anyone-can-pay lock"
          }
        }
      ],
      "outputs": [
        {
          "label": "outputs",
          "body": {
            "zh": "任意",
            "en": "any"
          }
        }
      ],
      "layouts": [],
      "limits": [
        {
          "field": "args",
          "cond": {
            "zh": "长度 40",
            "en": "length 40"
          },
          "err": "2"
