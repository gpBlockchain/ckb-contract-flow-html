        }
      ],
      "outputs": [
        {
          "label": {
            "zh": "挂单 cell",
            "en": "offer cell"
          },
          "body": "Cell{\n  lock: { codeHash: SALE_LOCK, hashType: {{type}},\n          args: {{seller_lock_hash 32B ‖ price u64 LE}} },\n  capacity: deposit\n}"
        }
      ],
      "layouts": [
        {
          "label": {
            "zh": "lock.args（40 字节）",
            "en": "lock.args (40 bytes)"
          },
          "layout": [
            {
              "name": "seller_lock_hash",
              "size": "32B",
              "role": {
                "zh": "卖家完整 lock hash，收款与撤单身份",
