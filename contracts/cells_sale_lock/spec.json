          ],
          "hex": [
            [
              "args",
              "0x{{a1b2…(32B)}}{{00e40b5402000000}}  ← price 0x02540be400 = 10,000 CKB"
            ]
          ]
        },
        {
          "label": "sale_fee(price)",
          "layout": [
            {
              "name": "price ≥ 6,300 CKB",
              "size": "1%",
              "role": {
                "zh": "1% 分成",
                "en": "1% share"
              },
              "color": 1,
              "flex": 1
            },
            {
              "name": "630 ≤ price < 6,300",
              "size": "63 CKB",
              "role": {
                "zh": "固定 63 CKB",
                "en": "flat 63 CKB"
              },
              "color": 2,
              "flex": 1
            },
            {
              "name": "price < 630",
              "size": "0",
              "role": {
                "zh": "无分成",
                "en": "none"
              },
              "color": 3,
              "flex": 1
            }
          ],
          "hex": [
            [
              "10,000 CKB",
              "fee 100 CKB → seller 9,900 + deposit"
