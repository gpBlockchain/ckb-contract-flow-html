      ],
      "limits": [
        {
          "field": "—",
          "cond": {
            "zh": "创建 lock 不执行脚本；约束在花费时检查",
            "en": "creating a lock runs no script; checks happen at spend"
          },
          "err": "—"
        }
      ]
    },
    {
      "tag": "1 → 0",
      "title": {
        "zh": "撤单 / 改价（卖家路径）",
        "en": "Cancel / relist (seller path)"
